{
  "mcpServers": {
    "google-flow": {
      "command": "node",
      "args": ["C:/caminho/para/custom-google-flow-mcp/dist/bin.js"],
      "env": {
        "FLOW_MCP_BROWSER_MODE": "auto",
        "FLOW_MCP_CDP_URL": "http://127.0.0.1:9222",
        "FLOW_MCP_OUTPUT_ROOT": "C:/Projetos",
        "FLOW_MCP_MAX_CONCURRENCY": "2",
        "FLOW_MCP_MAX_RETRIES": "3"
      }
    }
  }
}

# Todas opcionais. Defina no bloco "env" do mcpServers.

# auto = conecta no CDP se já houver Chrome aberto na porta; senão lança Chrome com o perfil dedicado.
# cdp  = só conecta (falha se não houver Chrome com --remote-debugging-port).
# launch = sempre lança Chrome próprio com perfil dedicado.
# FLOW_MCP_BROWSER_MODE=auto
# FLOW_MCP_CDP_URL=http://127.0.0.1:9222
# FLOW_MCP_USER_DATA_DIR=C:\Users\voce\AppData\Local\custom-google-flow-mcp\chrome-profile
# FLOW_MCP_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# FLOW_MCP_HEADLESS=0
# FLOW_MCP_URL=https://flow.google.com/

# Raiz padrão dos projetos: <root>/<project_name>/Assets_Flow/Scene_01_Take_01.mp4
# FLOW_MCP_OUTPUT_ROOT=C:/Projetos

# Fila
# FLOW_MCP_MAX_CONCURRENCY=2
# FLOW_MCP_MAX_RETRIES=3
# FLOW_MCP_RETRY_BASE_MS=15000
# FLOW_MCP_GENERATION_TIMEOUT=600

# Logs e screenshots de diagnóstico (padrão: ./logs do projeto)
# FLOW_MCP_LOG_DIR=
